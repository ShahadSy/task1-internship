@model IEnumerable<internship.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New User</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.Role</td>
           <td>
    <a asp-action="Details" asp-route-id="@user.Id"
       class="btn btn-outline-secondary btn-sm">Details</a>

    <a asp-action="Edit" asp-route-id="@user.Id"
       class="btn btn-outline-primary btn-sm">Edit</a>

    <a asp-action="Delete" asp-route-id="@user.Id"
       class="btn btn-outline-danger btn-sm">Delete</a>
</td>
        </tr>
    }
    </tbody>
</table>